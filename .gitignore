# dependencies
/node_modules

# next.js build output
/.next/
/out/
/out-small/
/out-base/
# the Build Output API layout npm run build:vercel writes (scripts/vercel-output.mjs), and any local Vercel link
/.vercel/
/test-results/
/playwright-report/

# MCP bundle staging + output (npm run mcpb); the bundle ships as a release asset
/.mcpb/
/dist/

# generated
/public/manual/
next-env.d.ts
*.tsbuildinfo

# env / secrets
.env*

# belt-and-suspenders: never commit imaging, even accidentally dropped test exports
*.dcm
*.dicom
DICOMDIR
*.jpg
*.jpeg

# app-data must never enter the repo, even if CBCTSCOPE_DATA points inside it
.cbctscope/
source.json
evidence/

# OS cruft
.DS_Store

# agent-harness local config
.claude/

# desktop app packages (npm run desktop:build); binaries ship as release assets only
/dist-desktop/
